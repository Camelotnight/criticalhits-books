---
import '@fontsource-variable/space-grotesk';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-400-italic.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '../styles/global.css';
import { SIGNUP_CTA } from '../config';
import { getImage } from 'astro:assets';
import coverSrc from '../assets/cover.jpg';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
// Link previews (texts, social posts) show the cover.
const ogCover = await getImage({ src: coverSrc, width: 800, format: 'jpg' });
const ogImage = new URL(ogCover.src, Astro.site);
const fullTitle = title === 'Home' ? 'Robert Hasleton · The Jovian Crisis' : `${title} · Robert Hasleton`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const nav = [
  { href: '/book/', label: 'The Book' },
  { href: '/read/the-rescue/', label: 'Read Ch. 4', mark: true },
  { href: '/ship/', label: 'The Ship' },
  { href: '/crew/', label: 'The Crew' },
  { href: '/world/', label: 'The World' },
  { href: '/wiki/', label: 'Encyclopedia' },
];
const isCurrent = (href: string) => {
  const h = href.replace(/\/$/, '') || '/';
  return h === path || (h === '/wiki' && path.startsWith('/wiki/'));
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0b0f15" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Cover of The Jovian Crisis by Robert Hasleton" />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex" />}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/">
          <span class="brand-name">Robert Hasleton</span>
          <span class="brand-sub">The Capa Incident</span>
        </a>
        <nav class="nav-wide" aria-label="Main">
          <ul>
            {nav.map((item) => (
              <li>
                <a href={item.href} class={item.mark ? 'mark' : undefined} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="nav-phone">
          <a class="mark" href="/read/the-rescue/" aria-current={isCurrent('/read/the-rescue/') ? 'page' : undefined}>Read Ch. 4</a>
          <details class="menu">
            <summary>Menu</summary>
            <nav aria-label="Main">
              <ul>
                {nav.filter((item) => !item.mark).map((item) => (
                  <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
                ))}
                <li><a href="/about/" aria-current={isCurrent('/about/') ? 'page' : undefined}>About</a></li>
              </ul>
            </nav>
          </details>
        </div>
        <script is:inline>
          // Close the phone menu on an outside tap or Escape.
          document.addEventListener('click', (e) => { const m = document.querySelector('.menu[open]'); if (m && !m.contains(e.target)) m.open = false; });
          document.addEventListener('keydown', (e) => { const m = document.querySelector('.menu[open]'); if (m && e.key === 'Escape') { m.open = false; m.querySelector('summary').focus(); } });
        </script>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <p>© 2026 Robert Hasleton. All rights reserved.</p>
        <p class="muted"><a href="/about/">About</a> · <a href="/about/#signup">{SIGNUP_CTA}</a></p>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 10;
    padding: 0.6rem 1rem;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 600;
    border-radius: var(--radius);
  }
  .skip:focus { top: 1rem; }

  .site-header {
    border-bottom: 1px solid var(--line);
    background: rgba(11, 15, 21, 0.92);
    z-index: 5;
  }
  @media (min-width: 720px) {
    .site-header { position: sticky; top: 0; backdrop-filter: blur(6px); }
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 0.75rem;
  }
  .brand {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--text);
    line-height: 1.2;
  }
  .brand-name { font-family: var(--font-display); font-weight: 600; font-size: 1.05rem; letter-spacing: 0.02em; }
  .brand-sub { font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.1rem 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: inline-block;
    padding: 0.55rem 0.6rem;
    min-height: 44px;
    line-height: 1.8;
    color: var(--muted);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 0.92rem;
    border-bottom: 2px solid transparent;
  }
  nav a:hover { color: var(--text); }
  /* Read Ch. 4: same size as every other link, marked by a small amber dot (amber underline still means "you are here"). */
  .bar a.mark::before { content: ''; display: inline-block; width: 6px; height: 6px; margin-right: 0.45rem; border-radius: 50%; background: var(--accent); vertical-align: 0.12em; }
  .nav-phone { display: none; align-items: center; gap: 0.25rem; }
  .nav-phone > a.mark { padding: 0.55rem 0.6rem; min-height: 44px; line-height: 1.8; color: var(--text); text-decoration: none; font-family: var(--font-display); font-size: 0.92rem; border-bottom: 2px solid transparent; }
  .nav-phone > a.mark[aria-current='page'] { border-bottom-color: var(--accent); }
  .menu { position: relative; }
  .menu summary { list-style: none; cursor: pointer; min-height: 44px; display: flex; align-items: center; padding: 0 0.8rem; font-family: var(--font-display); font-size: 0.92rem; color: var(--text); border: 1px solid var(--line-strong); border-radius: var(--radius); }
  .menu summary::-webkit-details-marker { display: none; }
  .menu summary::after { content: ''; margin-left: 0.5rem; width: 0.45rem; height: 0.45rem; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(45deg) translateY(-2px); }
  .menu[open] summary::after { transform: rotate(-135deg) translateY(-1px); }
  .menu nav { position: absolute; right: 0; top: calc(100% + 0.4rem); min-width: 13rem; background: #0e131a; border: 1px solid var(--line-strong); border-radius: var(--radius); box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5); padding: 0.35rem 0; z-index: 20; }
  .menu nav ul { flex-direction: column; gap: 0; }
  .menu nav a { display: block; padding: 0.55rem 1rem; }
  .menu nav a[aria-current='page'] { border-bottom-color: transparent; color: var(--text); box-shadow: inset 2px 0 0 var(--accent); }
  @media (max-width: 719px) {
    .nav-wide { display: none; }
    .nav-phone { display: flex; }
    .bar { flex-wrap: nowrap; }
  }
  nav a[aria-current='page'] { color: var(--text); border-bottom-color: var(--accent); }

  main:focus { outline: none; }

  .site-footer { border-top: 1px solid var(--line); padding-block: 2rem; font-size: 0.9rem; }
  .foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 2rem; }
  .foot p { margin: 0; }
</style>
