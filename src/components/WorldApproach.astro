       ['PTERMINAL', 'Common Table, four hulls, copy. Keep the hub approach clear.']],
      [['QUIET', 'Patroclus Terminal, Quiet Hours, community tender, bringing our water swap to the hub. Request a berth.'],
       ['PTERMINAL', 'Quiet Hours, berth assigned. Welcome back.']],
      [['PTERMINAL', 'Cluster tenders, water barges have the lanes this shift.']],
      [['PTERMINAL', 'Notice to all hulls: the Belt Code holds in this swarm. If you hear a call for help, you answer it.']],
    ],
  };
  // Cooper's Reach departs once per visit on the corridor, as three exchanges woven into the shuffle.
  const REACH_EX = [
    [['REACH', 'Minerva Traffic, Cooper’s Reach. On contract to Hercules II construction command. Standing by in the stack.', { pos: 'stack' }],
     ['TRAFFIC', 'Cooper’s Reach, copy. Your construction contract is on the board.']],
    [['REACH', 'Minerva Traffic, Cooper’s Reach. Ready to depart for the Hercules II yards.'],
     ['TRAFFIC', 'Cooper’s Reach, cleared to depart. Your departure vector is on your board.', { pos: 'ignite' }],
     ['REACH', 'Cleared to depart, vector received. Cooper’s Reach.']],
    [['TRAFFIC', 'Cooper’s Reach, burn confirmed. Safe coast to the yards.', { pos: 'coast' }]],
  ];
  const REACH_AT = { stack: 'translate(246 512)', ignite: 'translate(362 512)', coast: 'translate(452 512)' };
  const SAY = { stack: 'Cooper’s Reach is on the map, holding in the stack.', ignite: 'Cooper’s Reach is cleared and moving to its ignition marker.', coast: 'Cooper’s Reach has burned and is coasting out to the Hercules yards.' };
  // A fresh order each day, the same all day: seeded from the date.
  const today = new Date(), daySeed = today.getFullYear() * 1000 + Math.floor((today - new Date(today.getFullYear(), 0, 0)) / 864e5);
  const trng = ((a) => () => { a |= 0; a = a + 0x6D2B79F5 | 0; let t = Math.imul(a ^ a >>> 15, 1 | a); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; })(daySeed);
  const PHON = ['Alfa', 'Bravo', 'Charlie', 'Delta', 'Echo', 'Foxtrot', 'Golf', 'Hotel', 'India', 'Juliett', 'Kilo', 'Lima', 'Mike', 'November', 'Oscar', 'Papa', 'Quebec', 'Romeo', 'Sierra', 'Tango', 'Uniform', 'Victor', 'Whiskey', 'X-ray', 'Yankee', 'Zulu'];
  const infoLetter = PHON[daySeed % 26];
  function shuffle(list) {
    const a = list.slice();
    for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(trng() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; }
    // Story exchanges keep their shuffled slots but play in step order.
    const slots = a.map((x, i) => (x.at(-1).story ? i : -1)).filter((i) => i >= 0);
    const story = slots.map((i) => a[i]).sort((x, y) => x.at(-1).step - y.at(-1).step);
    slots.forEach((i, k) => { a[i] = story[k]; });
    return a;
  }
  const calls = (ex) => ex.filter((c) => Array.isArray(c));
  const queue = { 1: [], 2: [], 3: [], 4: [], 5: [], 6: [] };
  let reachDone = 0;
  function refill(scale) {
    const order = shuffle(EX[scale]);
    if (scale === 2 && reachDone === 0) { // weave the Reach in near the start of the first corridor visit
      order.splice(1, 0, REACH_EX[0]); order.splice(4, 0, REACH_EX[1]); order.splice(6, 0, REACH_EX[2]); reachDone = 1;
    }
    order.forEach((ex) => calls(ex).forEach((c, k) => queue[scale].push([...c, k > 0])));
  }
  const tr = document.getElementById('traffic'), log = document.getElementById('trlog'), say = document.getElementById('trsay');
  const pauseBtn = document.getElementById('trpause'), nextBtn = document.getElementById('trnext');
  const reachMk = document.getElementById('reachmk');
  let mins = 6 * 60 + 12, timer = null, paused = false, onScreen = true, beat = 0;
  const hhmm = (m) => { m = ((m % 1440) + 1440) % 1440; return `${String(Math.floor(m / 60)).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`; };
  const fill = (t) => t.replaceAll('@INFO@', infoLetter);
  const shipify = (t) => SHIPNAMES.reduce((acc, n) => acc.split(n).join(`<span class="ship">${n}</span>`), t);
  function nameHtml(key) {
    const [name, , ship, pre] = REG[key];
    if (!ship) return fill(name);
    return pre ? `${pre} <span class="ship">${ship}</span>` : `<span class="ship">${ship}</span>`;
  }
  let nextIsReply = false;
  function call() {
    if (stop === 0) return;
    if (!queue[stop].length) refill(stop);
    const [who, text, opts, reply] = (() => { const c = queue[stop].shift(); return c.length === 3 ? [c[0], c[1], {}, c[2]] : [c[0], c[1], c[2] || {}, c[3]]; })();
    beat++;
    const li = document.createElement('li');
    if (who === 'REACH') li.className = 'reach';
    if (opts.lag) li.classList.add('relay');
    if (who === 'UNKNOWN') li.classList.add('weak');
    const link = REG[who][1];
    const cs = link ? `<a href="${link}">${nameHtml(who)}</a>` : nameHtml(who);
    const lag = opts.lag ? `<span class="lagtag">sent ${hhmm(mins - opts.lag)} · ${opts.lag} min by light</span>` : '';
    li.innerHTML = `<span class="ts">${hhmm(mins)}</span><span class="cs">${cs}</span>${who === 'REACH' ? '<span class="who">Cassandra · </span>' : ''}${lag}${shipify(fill(text))}`;
    log.appendChild(li);
    while (log.children.length > 40) log.firstElementChild.remove();
    log.scrollTop = log.scrollHeight;
    if (opts.pos) { reachMk.setAttribute('opacity', 1); reachMk.setAttribute('transform', REACH_AT[opts.pos]); say.textContent = SAY[opts.pos]; }
    mins += 1;
    nextIsReply = !!(queue[stop][0] && queue[stop][0][queue[stop][0].length - 1]);
  }
  const running = () => stop > 0 && !paused && onScreen && !document.hidden && !(reduce.matches || still());
  function tick() { call(); schedule(); }
  function schedule() {
    clearTimeout(timer); timer = null;
    if (!running()) return;
    // Replies come quickly; a new exchange waits longer, so the channel breathes unevenly like a real one.
    const gap = nextIsReply ? 2600 + trng() * 1800 : 6000 + trng() * 5000;
    timer = setTimeout(tick, gap);
  }
  let shownStop = -1;
  // ---- Price ticker: the Skuld City exchange (helium-3 against the standard, metals by the kilo). ----
  // Prices are illustrative and invented (flagged in README), set by Robert at 8x the first draft; they wander a little and never jump.
  // Fuel is cheaper at the wellhead (shu.md), so Hell One spot trades under the standard. The metals that were
  // precious on Earth sank into planetary cores; the Belt's metal asteroids are broken cores, so out here
  // platinum-group metals sell by the kilo. Rare earths stay dear: they are scattered thin through rock.
  // Rarity marks follow price tiers, a nod to the diamond marks of space games.
  const TICK = {
    5: { name: 'Skuld City exchange', unit: 'He-3 against the standard · metals in shu per kg · ◆ scarcity', note: 'Helium-3 is cheapest at the wellhead, and every scoop run finished or called off moves it. Earth’s precious metals sank to its core; the Belt’s metal asteroids are broken cores, so out here platinum and iridium sell by the kilo. Rare earths are scattered thin through rock and stay dear.',
      rows: [['He-3', 'spot, Hell One dock', 0.91, 3], ['He-3', 'delivered Minerva', 0.97, 3], ['He-3', 'delivered Luna City', 1.06, 3], ['He-3', 'next-cycle contract', 0.93, 3],
        ['D', 'deuterium, per kg', 305.6, 1], ['RUNS', 'finished / called off', '14 / 3', 0], ['FRT', 'freight to Luna, per tonne', 976, 0],
        ['Fe', 'iron', 0.16, 2], ['Ni', 'nickel', 2.48, 2], ['Co', 'cobalt', 9.92, 2], ['W', 'tungsten', 14.64, 2], ['Ag', 'silver', 72.8, 1], ['Nd', 'neodymium', 33.6, 1],
        ['Eu', 'europium', 58.4, 1], ['Yb', 'ytterbium', 40.8, 1], ['Dy', 'dysprosium', 116.8, 1], ['Tb', 'terbium', 386.4, 1], ['Ru', 'ruthenium', 488.0, 1], ['Pd', 'palladium', 563.2, 1],
        ['Pt', 'platinum', 681.6, 1], ['Re', 'rhenium', 760.0, 1], ['Au', 'gold', 972.0, 1], ['Os', 'osmium', 1216.0, 1], ['Ir', 'iridium', 1691.2, 1], ['Rh', 'rhodium', 2096.0, 1]] },
  };
  TICK[4] = TICK[5]; // the Skuld City exchange shows on both Callisto views
  const tk = document.getElementById('ticker'), tkRun = document.getElementById('tkrun');
  const tierOf = (px) => (typeof px !== 'number' ? '' : '◆'.repeat(px < 8 ? 0 : px < 80 ? 1 : px < 800 ? 2 : px < 1600 ? 3 : 4));
  let tkStop = -1, tkTimer = null, tkLive = [];
  function tkRender() {
    const T = TICK[stop];
    tk.hidden = !T;
    if (!T || tkStop === T) return;
    tkStop = T;
    document.getElementById('tkname').textContent = T.name;
    document.getElementById('tkunit').textContent = T.unit;
    document.getElementById('tknote').textContent = T.note;
    tkLive = T.rows.map((r) => ({ sym: r[0], lab: r[1], px: r[2], dec: r[3], ch: 0 }));
    const item = (r, i) => `<span class="tk-item" data-i="${i}"><span class="tk-sym">${r.sym}</span><span class="tk-lab">${r.lab}</span>${!['He-3', 'D', 'RUNS', 'FRT'].includes(r.sym) ? `<span class="tk-r" aria-label="scarcity ${tierOf(r.px).length} of 4">${tierOf(r.px)}</span>` : ''}<span class="tk-px"></span><span class="tk-ch"></span></span>`;
    const once = tkLive.map(item).join('');
    tkRun.innerHTML = once + `<span class="tk-dup" aria-hidden="true">${once}</span>`;
    tkPaint();
  }
  function tkPaint() {
    tkRun.querySelectorAll('.tk-item').forEach((el) => {
      const r = tkLive[+el.dataset.i];
      el.querySelector('.tk-px').textContent = typeof r.px === 'number' ? r.px.toLocaleString('en-US', { minimumFractionDigits: r.dec, maximumFractionDigits: r.dec }) : r.px;
      const c = el.querySelector('.tk-ch');
      if (typeof r.px !== 'number') { c.textContent = ''; return; }
      c.className = 'tk-ch ' + (r.ch >= 0 ? 'up' : 'dn');
      c.textContent = `${r.ch >= 0 ? '▲' : '▼'}${Math.abs(r.ch).toFixed(1)}%`;
    });
  }
  function tkStep() {
    tkLive.forEach((r) => { if (typeof r.px !== 'number' || trng() < 0.6) return; const m = (trng() - 0.5) * 0.008; r.px = Math.max(r.px * (1 + m), 10 ** -r.dec); r.ch = Math.max(-2.4, Math.min(2.4, r.ch + m * 100)); });
    tkPaint();
  }
  function tkSync() {
    tkRender();
    clearInterval(tkTimer); tkTimer = null;
    if (TICK[stop] && !(reduce.matches || still()) && !document.hidden) tkTimer = setInterval(tkStep, 2560);
  }

  // ---- Weight calculator on Minerva's tiers: what a scale reads at each tier's gee. ----
  const wg = document.getElementById('weigh'), wgVal = document.getElementById('wgval'), wgList = document.getElementById('wglist');
  let wgUnit = 'lb';
  try { const m = JSON.parse(localStorage.getItem('minerva-weight') || 'null'); if (m && m.v > 0) { wgVal.value = m.v; wgUnit = m.u === 'kg' ? 'kg' : 'lb'; } } catch (e) {}
  const wgFmt = (g) => { const v = parseFloat(wgVal.value); return v > 0 ? `${Math.round(v * g).toLocaleString('en-US')} ${wgUnit}` : '·'; };
  function wgPaint() {
    wg.querySelectorAll('[data-unit]').forEach((b) => b.setAttribute('aria-pressed', b.dataset.unit === wgUnit));
    if (stop !== 3) return;
    const items = STOPS[3].items;
    wgList.innerHTML = items.map((it, i) => `<li><button type="button" data-i="${i}" aria-current="${i === sel}"><span>${it.title}</span><span class="wg-g">${(it.g || 0).toFixed(1)} gee</span><span class="wg-w">${wgFmt(it.g || 0)}</span></button></li>`).join('');
    wgList.querySelectorAll('button').forEach((b) => { b.onclick = () => select(+b.dataset.i); });
    const it = items[sel]; if (it) document.getElementById('carg').textContent = `${(it.g || 0).toFixed(1)} GEE · ${wgFmt(it.g || 0).toUpperCase()}`;
    try { localStorage.setItem('minerva-weight', JSON.stringify({ v: parseFloat(wgVal.value) || 0, u: wgUnit })); } catch (e) {}
  }
  wgVal.addEventListener('input', wgPaint);
  wg.querySelectorAll('[data-unit]').forEach((b) => { b.onclick = () => {
    const to = b.dataset.unit; if (to === wgUnit) return;
    const v = parseFloat(wgVal.value); if (v > 0) wgVal.value = Math.round(to === 'kg' ? v * 0.45359237 : v / 0.45359237);
    wgUnit = to; wgPaint();
  }; });
  const _wgSelect = select; select = (i, f) => { _wgSelect(i, f); if (stop === 3) { wgPaint(); const it = STOPS[3].items[i]; document.getElementById('wgsay').textContent = `${it.title}: you would weigh ${wgFmt(it.g || 0)}.`; } };
  function wgSync() { wg.hidden = stop !== 3; if (stop === 3) wgPaint(); }

  function sync() {
    wgSync();
    tkSync();
    tr.classList.toggle('idle', stop === 0);
    if (stop > 0 && stop !== shownStop) {
      document.getElementById('trafficlabel').lastChild.textContent = ({ 3: 'Minerva Civilian Control', 4: 'Hell One port', 5: 'Skuld City municipal band', 6: 'Patroclus Terminal' })[stop] || 'Minerva Traffic';
      call(); if (nextIsReply) call();
      shownStop = stop;
    }
    schedule();
    pauseBtn.textContent = paused ? 'Resume' : 'Pause'; pauseBtn.setAttribute('aria-pressed', paused);
    pauseBtn.hidden = reduce.matches || still();
  }
  new IntersectionObserver((es) => { onScreen = es[0].isIntersecting; sync(); }).observe(tr);
  document.addEventListener('visibilitychange', sync);
  pauseBtn.onclick = () => { paused = !paused; sync(); };
  nextBtn.onclick = () => call();
  const _go = go; go = (n) => { _go(n); sync(); };
  const _setStill = setStill; setStill = (on) => { _setStill(on); sync(); };
  motionBtn.onclick = () => setStill(!still());

  // Deep links: ?stop=2&item=3 (also used for screenshots).
  const q = new URLSearchParams(location.search);
  stop = Math.min(6, +q.get('stop') || 0); layers[stop].classList.add('on');
  renderItems(); select(Math.min(+q.get('item') || 0, STOPS[stop].items.length - 1));
  for (let i = 0; i < (+q.get('calls') || 0); i++) call();
  sync();
})();

</script>
