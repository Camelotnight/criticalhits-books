---
// The site's one sign-up box (Kit). Form ID and wording come from src/config.ts:
// SIGNUP_MODE 'arc' asks for advance reader copies; 'newsletter' is the approved list copy.
import KitForm from './KitForm.astro';
import { KIT_FORM_ID, RELEASE, SIGNUP_MODE } from '../config';

interface Props {
  id?: string;
}
const { id = 'signup' } = Astro.props;
const arc = SIGNUP_MODE === 'arc';
---
<section class="signup" id={id} aria-labelledby={`${id}-title`}>
  {arc ? (
    <>
      <p class="eyebrow">Advance reader copies</p>
      <h2 id={`${id}-title`}>ARC readers wanted</h2>
      <p>
        Advance copies of <em>The Jovian Crisis</em>, Book One of The Capa Incident, are going out now, ahead of
        its {RELEASE} release. Join the list to request one.
      </p>
    </>
  ) : (
    <>
      <h2 id={`${id}-title`}>Join the list</h2>
      <p>
        I'm Robert Hasleton. <em>The Jovian Crisis</em>, Book One of The Capa Incident, lands {RELEASE}.
        Join the list for release news, early chapters of Book Two, and the occasional look behind the science.
      </p>
    </>
  )}
  <p class="muted">No spam. One email when there's something worth saying.</p>

  <KitForm formId={KIT_FORM_ID} id={id} />
</section>

<style>
  .signup {
    background: var(--panel);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    padding: clamp(1.25rem, 4vw, 2rem);
    max-width: 40rem;
  }
</style>
