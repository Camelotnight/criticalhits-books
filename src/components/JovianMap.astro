---
import Explorer from './Explorer.astro';
import {
  placeItems, MAP_VIEW, SUN, ORBIT_R, JUPITER, L4, L5, MOONS, CALLISTO, MINERVA, trojanCloud,
} from '../data/places';

const l4Cloud = trojanCloud(-150, 140, 4242);
const l5Cloud = trojanCloud(-30, 140, 2525);
const polar = (deg: number) => ({
  x: +(SUN.x + ORBIT_R * Math.cos((deg * Math.PI) / 180)).toFixed(1),
  y: +(SUN.y + ORBIT_R * Math.sin((deg * Math.PI) / 180)).toFixed(1),
});
const [arcFrom, arcTo] = [polar(-172), polar(-8)];
const arc = `M ${arcFrom.x} ${arcFrom.y} A ${ORBIT_R} ${ORBIT_R} 0 0 1 ${arcTo.x} ${arcTo.y}`;
const arrowAt = polar(-62);
const mid = { x: MINERVA.x + (CALLISTO.x - MINERVA.x) * 0.5, y: MINERVA.y + (CALLISTO.y - MINERVA.y) * 0.5 };
const crossingAngle = (Math.atan2(CALLISTO.y - MINERVA.y, CALLISTO.x - MINERVA.x) * 180) / Math.PI;
---
<Explorer
  name="map"
  label="Places"
  items={placeItems}
  aspect={`${MAP_VIEW.w} / ${MAP_VIEW.h}`}
  caption="The Jovian system and Jupiter’s Trojan clouds. Stylized and not to scale."
>
  <svg viewBox={`0 0 ${MAP_VIEW.w} ${MAP_VIEW.h}`} role="img" aria-labelledby="map-svg-title map-svg-desc">
    <title id="map-svg-title">Map of the Jovian system, not to scale</title>
    <desc id="map-svg-desc">
      Jupiter at the center with Io, Europa, Ganymede and Callisto. Jupiter's orbit curves across the map. Sixty degrees
      ahead of Jupiter is the L4 Trojan cloud, home of Minerva Station; sixty degrees behind is the L5 Trojan cloud.
      A dotted line marks the crossing from Minerva to Callisto.
    </desc>

    <text x="24" y="36" class="tag">NOT TO SCALE</text>

    <!-- Jupiter's orbit -->
    <path d={arc} class="orbit" />
    <g class="motion" transform={`translate(${arrowAt.x} ${arrowAt.y - 14}) rotate(28)`}>
      <path d="M 40 0 L 0 0 M 8 -5 L 0 0 L 8 5" />
      <text x="0" y="-7">ORBIT</text>
    </g>

    <!-- Sun, off the bottom edge -->
    <g class="sun">
      <circle cx={SUN.x} cy={SUN.y + 40} r="70" />
      <text x={SUN.x} y={MAP_VIEW.h - 10} text-anchor="middle">SUN ↓ 5.2 AU</text>
    </g>

    <!-- Lagrange geometry -->
    <g class="geom">
      <line x1={SUN.x} y1={SUN.y} x2={JUPITER.x} y2={JUPITER.y} />
      <line x1={SUN.x} y1={SUN.y} x2={L4.x} y2={L4.y} />
      <line x1={SUN.x} y1={SUN.y} x2={L5.x} y2={L5.y} />
      <text x={SUN.x - 46} y={SUN.y - 60}>60°</text>
      <text x={SUN.x + 30} y={SUN.y - 60}>60°</text>
    </g>

    <!-- Trojan clouds -->
    <g data-part="l4" class="part cloud">
      {l4Cloud.map((p) => <circle cx={p.x} cy={p.y} r={p.size} />)}
      <text x={L4.x} y={L4.y + 58} text-anchor="middle" class="region">L4 · LEADING TROJANS</text>
    </g>
    <g data-part="l5" class="part cloud">
      {l5Cloud.map((p) => <circle cx={p.x} cy={p.y} r={p.size} />)}
      <text x={L5.x} y={L5.y + 58} text-anchor="middle" class="region">L5 · TRAILING TROJANS</text>
    </g>

    <!-- Minerva → Callisto crossing -->
    <g class="crossing">
      <line x1={MINERVA.x} y1={MINERVA.y} x2={CALLISTO.x} y2={CALLISTO.y} />
      <text transform={`translate(${mid.x} ${mid.y - 8}) rotate(${crossingAngle})`} text-anchor="middle">
        5.2 AU AT HALF A G
      </text>
    </g>

    <!-- Jupiter and the Galilean moons -->
    <g class="moons">
      {MOONS.map((m) => <circle cx={JUPITER.x} cy={JUPITER.y} r={m.r} class="moon-orbit" />)}
    </g>
    <g class="jupiter">
      <circle cx={JUPITER.x} cy={JUPITER.y} r="24" class="planet" />
      <path d={`M ${JUPITER.x - 23} ${JUPITER.y - 7} H ${JUPITER.x + 23} M ${JUPITER.x - 24} ${JUPITER.y + 2} H ${JUPITER.x + 24} M ${JUPITER.x - 21} ${JUPITER.y + 11} H ${JUPITER.x + 21}`} class="bands" />
      <text x={JUPITER.x} y={JUPITER.y - 132} text-anchor="middle" class="name">JUPITER</text>
    </g>
    {MOONS.map((m) => (
      <g data-part={m.name === 'Callisto' ? 'callisto' : undefined} class:list={['moon', { part: m.name === 'Callisto' }]}>
        <circle cx={m.x} cy={m.y} r={m.name === 'Callisto' ? 5 : 3.5} />
        <text x={m.name === 'Callisto' ? m.x - 9 : m.x + 8} y={m.y + 4} text-anchor={m.name === 'Callisto' ? 'end' : 'start'}>{m.name}</text>
      </g>
    ))}

    <!-- Minerva Station -->
    <g data-part="minerva" class="part station">
      <rect x={MINERVA.x - 5} y={MINERVA.y - 5} width="10" height="10" transform={`rotate(45 ${MINERVA.x} ${MINERVA.y})`} />
      <text x={MINERVA.x + 12} y={MINERVA.y - 10}>MINERVA</text>
    </g>
  </svg>
</Explorer>

<style>
  svg :global(text) { font-family: var(--font-display); }
  svg :global(.tag) { fill: #e3a857; font-size: 13px; letter-spacing: 0.2em; }
  svg :global(.orbit) { fill: none; stroke: #3b4f68; stroke-width: 1.2; stroke-dasharray: 6 6; }
  svg :global(.motion path) { fill: none; stroke: #6d7f95; stroke-width: 1.2; }
  svg :global(.motion text) { fill: #6d7f95; font-size: 11px; letter-spacing: 0.08em; }
  svg :global(.sun circle) { fill: #e3a857; fill-opacity: 0.12; stroke: #e3a857; stroke-opacity: 0.4; }
  svg :global(.sun text) { fill: #b98a4d; font-size: 11px; letter-spacing: 0.16em; }
  svg :global(.geom line) { stroke: #243142; stroke-width: 1; }
  svg :global(.geom text) { fill: #5f6f84; font-size: 11px; }
  svg :global(.cloud circle) { fill: #9aa7b6; fill-opacity: 0.55; }
  svg :global(.region) { fill: #9aa7b6; font-size: 12px; letter-spacing: 0.14em; }
  svg :global(.crossing line) { stroke: #7cc8dc; stroke-width: 1.3; stroke-dasharray: 2 6; stroke-linecap: round; }
  svg :global(.crossing text) { fill: #7cc8dc; font-size: 10.5px; letter-spacing: 0.12em; }
  svg :global(.moon-orbit) { fill: none; stroke: #243142; stroke-width: 1; }
  svg :global(.planet) { fill: #c58b52; }
  svg :global(.bands) { stroke: #8f5a32; stroke-width: 3; stroke-opacity: 0.7; }
  svg :global(.name) { fill: #dde3ea; font-size: 13px; letter-spacing: 0.24em; }
  svg :global(.moon circle) { fill: #b9c3cf; }
  svg :global(.moon text) { fill: #9aa7b6; font-size: 12px; }
  svg :global(.station rect) { fill: #e3a857; }
  svg :global(.station text) { fill: #e3a857; font-size: 12px; letter-spacing: 0.16em; }
  svg :global(.part) { transition: filter 0.2s ease; }

  :global([data-explorer='map'][data-selected='map-minerva']) svg :global([data-part='minerva']),
  :global([data-explorer='map'][data-selected='map-callisto']) svg :global([data-part='callisto']) {
    filter: drop-shadow(0 0 5px rgba(227, 168, 87, 0.9));
  }
  :global([data-explorer='map'][data-selected='map-callisto']) svg :global([data-part='callisto'] circle) { fill: #e3a857; }
  :global([data-explorer='map'][data-selected='map-l5']) svg :global([data-part='l5'] circle) { fill: #e3a857; fill-opacity: 0.8; }
  :global([data-explorer='map'][data-selected='map-minerva']) svg :global([data-part='l4'] circle) { fill-opacity: 0.8; }
</style>
