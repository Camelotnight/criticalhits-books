---
import BookStrip from '../../components/BookStrip.astro';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SECTIONS } from '../../content.config';
import { extrasOf } from '../../lib/extras';

export async function getStaticPaths() {
  const all = await getCollection('wiki');
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry, all } }));
}

const { entry, all } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const section = SECTIONS[d.section];
const ex = extrasOf(entry.body);
const related = d.related
  .map((id: string) => all.find((e) => e.id === id))
  .filter(Boolean);
const siblings = all
  .filter((e) => e.data.section === d.section && e.id !== entry.id)
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
---
<Base title={d.title} description={d.summary}>
  <section class="section">
    <div class="wrap layout">
      <article class="article">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/wiki/">Encyclopedia</a> <span aria-hidden="true">/</span>
          <a href={`/wiki/#${d.section}`}>{section.title}</a>
        </nav>
        <h1>{d.title}</h1>
        {d.aka && <p class="aka">Also: {d.aka.join(' · ')}</p>}
        <p class="lede">{d.summary}</p>

        {(ex.note || ex.interactive) && (
          <p class="extras">
            {ex.note && (
              <a class="extra-chip" href="#field-note" data-play-note>
                <span aria-hidden="true">▶</span> Field note from Gavin{ex.note.length && ` · ${ex.note.length}`}
              </a>
            )}
            {ex.interactive && (
              <a class="extra-chip extra-chip--int" href={`#${ex.interactive.anchor}`}>
                <span aria-hidden="true">◆</span> Interactive: {ex.interactive.title.split(':').pop()!.trim()}
              </a>
            )}
          </p>
        )}

        {d.inshort && (
          <aside class="inshort" aria-label="New to the book?">
            <p class="rule-label">New to the book?</p>
            <dl>
              {d.inshort.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
            </dl>
          </aside>
        )}

        {d.infobox && (
          <aside class="infobox" aria-label="At a glance">
            <p class="rule-label">At a glance</p>
            <dl>
              {d.infobox.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
            </dl>
          </aside>
        )}

        <div class="body"><Content /></div>

        {related.length > 0 && (
          <footer class="see-also">
            <p class="rule-label">See also</p>
            <ul>
              {related.map((r) => (
                <li><a href={`/wiki/${r!.id}/`}>{r!.data.title}</a><span class="muted"> {r!.data.summary}</span></li>
              ))}
            </ul>
          </footer>
        )}
      </article>

      <aside class="side" aria-label={`More in ${section.title}`}>
        <p class="rule-label">{section.title}</p>
        <ul>
          {siblings.map((s) => (<li><a href={`/wiki/${s.id}/`}>{s.data.title}</a></li>))}
        </ul>
        <p class="side-foot"><a href="/wiki/glossary/">Quick glossary →</a></p>
      </aside>
    </div>
  </section>
  <BookStrip />
</Base>

<script>
  // The field-note chip jumps to the note and starts Gavin's audio (the click is the reader's choice to listen).
  document.querySelector<HTMLAnchorElement>('[data-play-note]')?.addEventListener('click', () => {
    const a = document.querySelector<HTMLAudioElement>('#field-note audio');
    if (a) a.play().catch(() => {});
  });
</script>

<style>
  .layout { display: grid; gap: 3rem; }
  @media (min-width: 960px) { .layout { grid-template-columns: minmax(0, 1fr) 15rem; } }
  .article { max-width: var(--measure); }
  .crumbs { font-size: 0.85rem; color: var(--muted); margin-bottom: 1rem; }
  .crumbs a { color: var(--muted); }
  .crumbs span { margin: 0 0.4rem; }
  .aka { color: var(--muted); font-size: 0.95rem; margin-top: -0.4rem; }

  .infobox {
    margin: 1.5rem 0 2rem;
    padding: 1rem 1.2rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
  }
  @media (min-width: 1200px) {
    .infobox { float: right; width: 18rem; margin: 0.25rem -2rem 1rem 2rem; }
  }
  .infobox dl { display: grid; grid-template-columns: max-content 1fr; gap: 0.35rem 0.9rem; margin: 0.5rem 0 0; font-size: 0.9rem; }
  .infobox dt { color: var(--muted); }
  .infobox dd { margin: 0; }

  .inshort {
    margin: 1.5rem 0 2rem;
    padding: 1rem 1.2rem 0.4rem;
    background: rgba(227, 168, 87, 0.06);
    border: 1px solid rgba(227, 168, 87, 0.35);
    border-radius: var(--radius);
  }
  .inshort dl { margin: 0.6rem 0 0; }
  .inshort div { margin-bottom: 0.7rem; }
  .inshort dt { font-family: var(--font-display); font-weight: 600; font-size: 0.95rem; color: var(--accent); }
  .inshort dd { margin: 0.1rem 0 0; }

  .body :global(h2) { margin-top: 2.2rem; }
  .body :global(h3) { margin-top: 1.6rem; color: var(--text); }
  .body :global(ul) { padding-left: 1.2rem; }
  .body :global(li) { margin-bottom: 0.35rem; }
  .body :global(blockquote) { margin: 1.5rem 0; padding-left: 1rem; border-left: 2px solid var(--line-strong); color: var(--muted); }
  .body :global(table) { width: 100%; border-collapse: collapse; margin: 1.25rem 0; font-size: 0.92rem; }
  .body :global(th), .body :global(td) { text-align: left; padding: 0.45rem 0.6rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  .body :global(th) { color: var(--muted); font-weight: 600; }
  /* Menu card: a Minerva kiosk menu, styled like the station's own displays. */
  .body :global(.menu-card) { clear: both; margin: 1.75rem 0 2.25rem; padding: 1rem 1.2rem 0.9rem; border: 1px solid rgba(227, 168, 87, 0.45); border-radius: var(--radius); background: #0c1219; font-family: var(--font-display); }
  .body :global(.menu-card p) { margin: 0; }
  .body :global(.mc-head) { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.25rem 1rem; padding-bottom: 0.6rem; border-bottom: 1px solid var(--line); font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent); }
  .body :global(.mc-head span + span) { color: var(--muted); }
  .body :global(.mc-sec) { padding: 0.75rem 0 0.4rem; border-bottom: 1px dashed var(--line); }
  .body :global(.mc-title) { font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--signal); margin-bottom: 0.4rem !important; }
  .body :global(.mc-sec ul) { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.45rem; }
  .body :global(.mc-sec li) { display: grid; grid-template-columns: minmax(8.5rem, 11rem) 1fr; gap: 0.2rem 1rem; font-family: var(--font-body, inherit); font-size: 0.95rem; line-height: 1.45; }
  .body :global(.mc-sec li b) { font-family: var(--font-display); font-weight: 600; color: var(--text); }
  .body :global(.mc-sec li span) { color: var(--muted); }
  @media (max-width: 34rem) { .body :global(.mc-sec li) { grid-template-columns: 1fr; } }
  .body :global(.mc-foot) { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.25rem 1rem; padding-top: 0.6rem; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .body :global(.mc-foot span + span) { color: var(--accent); }

  .body :global(.science) {
    clear: both;
    margin: 2.5rem 0 1rem;
    padding: 1.2rem 1.4rem 0.4rem;
    background: rgba(124, 200, 220, 0.06);
    border: 1px solid rgba(124, 200, 220, 0.35);
    border-radius: var(--radius);
  }
  .body :global(.science h2) {
    margin-top: 0;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--signal);
  }

  /* Further reading: real-world sources, out of the site in a new tab. Only inside science boxes. */
  .body :global(.science .further) {
    margin: 1.1rem 0 0.9rem;
    padding-top: 0.7rem;
    border-top: 1px solid rgba(124, 200, 220, 0.25);
    font-size: 0.86rem;
    line-height: 1.7;
    color: var(--muted);
  }
  .body :global(.science .further > span:first-child) {
    margin-right: 0.4rem;
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--signal);
  }

  /* In-world sidebar: a researcher's field notes, set apart like a margin story in a sourcebook. */
  .body :global(.fieldnote) {
    clear: both;
    margin: 2.5rem 0 1rem;
    padding: 1.3rem 1.5rem 0.6rem;
    background: var(--panel);
    border: 1px solid var(--line-strong);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    font-size: 0.97rem;
  }
  .body :global(.fieldnote h2) {
    margin: 0;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .body :global(.fieldnote h3) {
    margin: 0.5rem 0 0.2rem;
    font-size: 1.35rem;
    color: var(--text);
  }
  .extras { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: -0.4rem 0 1.4rem; }
  .extra-chip { display: inline-flex; align-items: center; gap: 0.45rem; min-height: 36px; padding: 0.3rem 0.8rem; border: 1px solid rgba(227, 168, 87, 0.55); border-radius: 999px; font-family: var(--font-display); font-size: 0.85rem; color: var(--accent); text-decoration: none; background: rgba(227, 168, 87, 0.06); }
  .extra-chip:hover, .extra-chip:focus-visible { background: rgba(227, 168, 87, 0.16); }
  .extra-chip--int { border-color: rgba(124, 200, 220, 0.55); color: var(--signal); background: rgba(124, 200, 220, 0.06); }
  .extra-chip--int:hover, .extra-chip--int:focus-visible { background: rgba(124, 200, 220, 0.16); }
  .body :global(.fieldnote) { scroll-margin-top: 5rem; }
  .body :global(#cav) { scroll-margin-top: 5rem; }
  .body :global(.fieldnote .sitenote) { margin: -0.6rem 0 1rem; font-size: 0.8rem; font-style: italic; color: var(--muted); }
  .body :global(.fieldnote .byline) {
    margin: 0 0 1rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.85rem;
    color: var(--muted);
  }
  .body :global(.fieldnote blockquote) { color: var(--text); }
  .body :global(.fieldnote .listen) { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.9rem; margin: -0.2rem 0 1.1rem; }
  .body :global(.fieldnote .listen audio) { width: 100%; max-width: 26rem; height: 40px; }
  .body :global(.fieldnote .listen span) { font-size: 0.8rem; color: var(--muted); }

  .see-also { clear: both; margin-top: 3rem; }
  .see-also ul { list-style: none; padding: 0; margin: 0.75rem 0 0; display: grid; gap: 0.6rem; }
  .see-also li { font-size: 0.95rem; }
  .see-also li a { font-weight: 600; }

  .side { font-size: 0.92rem; }
  @media (min-width: 960px) { .side { position: sticky; top: 6rem; align-self: start; } }
  .side ul { list-style: none; padding: 0; margin: 0.75rem 0 1rem; display: grid; gap: 0.3rem; }
  .side a { color: var(--muted); text-decoration: none; }
  .side a:hover { color: var(--text); }
  .side-foot a { color: var(--signal); }
</style>
