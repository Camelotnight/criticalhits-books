---
import Base from '../layouts/Base.astro';
---
<Base title="Thank you" description="You're on the list." noindex>
  <section class="section">
    <div class="wrap prose">
      <p class="eyebrow">Signal received</p>
      <h1>Thank you</h1>
      <p class="lede">
        You're on the list. Check your inbox for a quick hello from me. If it's not there, look in Promotions or Spam
        and drag it over so the next one finds you.
      </p>
      <p><a href="/">Back to the home page</a> · <a href="/ship/">Tour the ship</a></p>
    </div>
  </section>
</Base>
