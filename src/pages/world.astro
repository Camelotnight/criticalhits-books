---
import Base from '../layouts/Base.astro';
import WorldApproach from '../components/WorldApproach.astro';
---
<Base title="The World" description="Zoom from the solar system down to Minerva Station in The Jovian Crisis, and listen in on Minerva Traffic.">
  <section class="section">
    <div class="wrap">
      <header class="prose head">
        <p class="eyebrow">The World</p>
        <h1>The Jovian system</h1>
        <p class="lede">
          Start at the scale of the solar system and come in on Minerva Station: through the leading Trojans, down the
          corridor to the Hercules yards, and into the tiers where weight is class. Once you reach Minerva, listen in on
          its traffic control.
        </p>
      </header>
      <WorldApproach />
    </div>
  </section>
</Base>

<style>
  .head { margin-bottom: 2rem; }
</style>
