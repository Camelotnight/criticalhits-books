---
import Base from '../layouts/Base.astro';
import WorldApproach from '../components/WorldApproach.astro';
---
<Base title="The World" description="Zoom from the solar system to Minerva Station, Callisto’s Skuld City and Patroclus in The Jovian Crisis, and listen in on their radio.">
  <section class="section">
    <div class="wrap">
      <header class="prose head">
        <p class="eyebrow">The World</p>
        <h1>The Jovian system</h1>
        <p class="lede">
          Start at the scale of the solar system and come in on Minerva Station: through the leading Trojans, down the corridor to the Hercules yards, and into the tiers where weight is class. Or take the other paths from the system view: down to Callisto and the turntable city of Skuld, or out to Patroclus at L5. Each place has its own radio.
        </p>
      </header>
      <WorldApproach />
    </div>
  </section>
</Base>

<style>
  .head { margin-bottom: 2rem; }
</style>
