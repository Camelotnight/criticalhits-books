<style is:global>
.read{max-width:74rem}.head{max-width:40rem;margin-bottom:2rem}
.meta{color:var(--muted);font-size:.9rem;margin:.25rem 0 1.25rem}
.lead p{margin:0 0 .75rem;line-height:1.6}.lead .why{color:var(--muted);font-size:.95rem}
.player{padding:.75rem .9rem;background:var(--bg-2);border:1px solid var(--line);border-radius:var(--radius);margin-bottom:1rem}
