---
// Read Chapter Four: the site's one approved excerpt, as text and as AI narration, with read-along and a
// suit display that changes only when the narration speaks a new number. Guardrails (red team): the lead-in,
// share text and pull quotes never use the chapter's clues about the Second Chance, never feature the spool,
// never name the survivors.
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import { PARAS, MARKS, CUES } from '../../data/the-rescue';
import { AMAZON_URL, AMAZON_LABEL, RELEASE, RELEASE_ISO, SIGNUP_CTA } from '../../config';
const words = PARAS.join(' ').replace(/<[^>]+>/g, '').split(/\s+/).length;
---
<Base title="Read Chapter Four: The Rescue" description="Read or listen to all of Chapter Four of The Jovian Crisis: a dead ship, two survivors, and twenty-five minutes of coolant.">
  <section class="section">
    <div class="wrap read">
      <header class="head">
        <p class="eyebrow">Read the rescue · Chapter Four</p>
        <h1>The Rescue</h1>
        <p class="meta">About {Math.round(words / 250)} minutes to read · 22 minutes to listen</p>
        <div class="lead">
          <p>
            A dead ship’s beacon has lit Kade Holloway’s board. The <em>Second Chance</em> is minutes from sublimating,
            two survivors are strapped into their crash couches, and <em>Cooper’s Reach</em> is the only ship close
            enough to reach them.
          </p>
          <p class="why">
            Why Chapter Four? It’s the rescue, and you need nothing else to follow it. On the radio: Kade and Dustin in
            the wreck; Cassandra, Carrie and Gunnar aboard the <em>Reach</em>. <a href="/crew/">Who’s who</a>.
          </p>
          <p class="note">Content note: injury and death.</p>
        </div>
      </header>

      <div class="body-grid">
        <div class="side">
          <div class="player" id="player">
            <audio id="aud" controls preload="none" src="/audio/read/the-rescue.mp3" aria-label="Listen to Chapter Four, The Rescue"></audio>
            <div class="pl-row">
              <button type="button" class="pl-btn" id="back15">Back 15 s</button>
              <label class="pl-speed">Speed
                <select id="speed"><option value="1">1×</option><option value="1.15">1.15×</option><option value="1.3">1.3×</option><option value="1.5">1.5×</option></select>
              </label>
              <label class="pl-follow"><input type="checkbox" id="follow" checked> Follow along</label>
              <a class="pl-dl" href="/audio/read/the-rescue.mp3" download>Download MP3</a>
            </div>
            <p class="pl-label">AI narration, not the audiobook. Tap any paragraph to listen from there.</p>
          </div>
        <aside class="hud2" id="hud" aria-label="Kade’s suit display">
          <div class="strip"><span class="sb">BINGO <b id="strip-bingo">··</b></span><span>GEL <b id="strip-gel">··</b></span><span>QUENCH <b id="strip-quench">··</b></span><span id="strip-status">STANDBY</span><button type="button" id="strip-open">Wireframe</button></div>
          <div class="hud-head"><p class="hud-title">Suit display</p><button type="button" id="therm" aria-pressed="true" disabled title="Thermal overlay (T)">Thermal</button><button type="button" id="hud-collapse" aria-expanded="true" aria-controls="hud-panel">Hide wireframe</button></div>
          <div id="hud-panel">
            <svg id="hudsvg" viewBox="0 0 360 300" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="heat" x1="0" x2="1"><stop offset="0" stop-color="#10303e"/><stop offset=".42" stop-color="#253442"/><stop offset=".66" stop-color="#8f4a1e"/><stop offset="1" stop-color="#c2391b"/></linearGradient>
    </defs>
    <path class="visor" d="M18 4 H342 L356 18 V282 L342 296 H18 L4 282 V18 Z"/>
    <path class="glare" d="M24 12 Q 180 2 336 12"/>
    <g id="bingo-row" class="row"><text x="14" y="26" class="rl">BINGO</text><rect x="72" y="18" width="214" height="8" class="track"/><rect id="bingo-fill" x="72" y="18" width="0" height="8" class="fill"/><text id="bingo-val" x="346" y="26" class="rv">··</text><g id="ticks"></g></g>
    <g id="gel-row" class="row"><text x="14" y="50" class="rl">GEL</text><rect x="72" y="42" width="214" height="8" class="track"/><rect id="gel-fill" x="72" y="42" width="0" height="8" class="fill cool"/><text id="gel-val" x="346" y="50" class="rv">··</text></g>
    <g id="quench-row" class="row"><text x="14" y="74" class="rl">QUENCH</text><rect x="72" y="66" width="214" height="8" class="track"/><rect id="quench-fill" x="72" y="66" width="0" height="8" class="fill hot"/><text id="quench-val" x="346" y="74" class="rv">··</text></g>
    <line x1="12" y1="88" x2="348" y2="88" class="sep"/>
    <text x="14" y="104" class="tiny">SECOND CHANCE · ABSTRACT PATH, NOT A DECK PLAN</text>
    <g id="hull">
      <path class="hullp" d="M60 150 H320 Q334 150 334 164 V212 Q334 226 320 226 H60 C36 226 22 206 22 188 C22 170 36 150 60 150 Z"/>
      <path class="ribs" d="M80 152V224M110 151V225M140 151V225M170 151V225M200 151V225M230 151V225M260 151V225M290 151V225M316 152V224"/>
      <text x="30" y="146" class="tiny dim">NOSE</text><text x="330" y="146" text-anchor="end" class="tiny dim">AFT</text>
    </g>
    <polyline id="lane-in" class="lane" points="262,150 254,166 236,176 104,176 72,192"/>
    <g id="chevrons" class="chev"><path d="M224 172l-5 4 5 4M204 172l-5 4 5 4M184 172l-5 4 5 4M164 172l-5 4 5 4M144 172l-5 4 5 4M124 172l-5 4 5 4"/></g>
    <polyline id="lane-out" class="lane out" points="72,192 120,204 160,206 190,226"/>
    <g id="dual"><polyline class="d-you" points="72,188 120,200 160,202 194,224"/><polyline class="d-sled" points="72,197 120,209 160,211 186,228"/>
      <text x="212" y="214" class="tiny cy">YOU</text><text x="212" y="238" class="tiny am">SLED</text></g>
    <g id="n-airlock" class="node"><circle cx="262" cy="150" r="4"/><path class="x" d="M258 146l8 8M266 146l-8 8"/><text x="262" y="140" text-anchor="middle">AIRLOCK</text></g>
    <g id="n-staged" class="node"><circle cx="236" cy="176" r="3.5"/><text x="236" y="166" text-anchor="middle">SLED STAGED</text></g>
    <g id="n-pinch" class="node"><circle cx="194" cy="176" r="3.5"/><text x="194" y="194" text-anchor="middle">PINCH POINT</text></g>
    <g id="n-quarters" class="node"><circle cx="148" cy="176" r="3.5"/><text x="148" y="166" text-anchor="middle">CREW QUARTERS</text></g>
    <g id="n-door" class="node"><circle cx="104" cy="176" r="3.5"/><text x="96" y="194" text-anchor="middle">COMMAND DECK DOOR</text></g>
    <g id="n-aft" class="node hollow"><circle cx="302" cy="198" r="3.5"/></g>
    <g id="n-pdoors" class="node red"><rect x="156" y="198" width="8" height="16"/><text x="150" y="222" text-anchor="end">PRESSURE DOORS</text></g>
    <g id="n-hatch" class="node amber"><circle cx="190" cy="226" r="4"/><text x="190" y="242" text-anchor="middle">MID-SHIP HATCH</text></g>
    <line id="tether" class="tether"/>
    <g id="sled" class="mk sled"><rect x="-7" y="-4" width="14" height="8" rx="1.5"/></g>
    <g id="dustin" class="mk dustin"><circle r="3.6"/></g>
    <g id="kade" class="mk kade"><path d="M0 -6 L6 0 L0 6 L-6 0 Z"/></g>
    <g id="bees"></g>
    <g id="traces"><rect x="12" y="232" width="124" height="60" rx="3" class="tbox"/>
      <text id="pod" x="18" y="243" class="tiny cy">BEES FEED · 2 TRACES</text>
      <text x="18" y="261" class="tlbl">T1</text><g transform="translate(28 246) scale(1 .6)"><path class="wave weak" d="M4 20 h8 l2 -3 l2 5 l2 -2 h14 l2 -3 l2 5 l2 -2 h16"/></g><text id="t1-tag" x="98" y="261" class="tlbl">WEAK</text>
      <text x="18" y="281" class="tlbl">T2</text><g transform="translate(28 266) scale(1 .6)"><path id="t2-wave" class="wave fast" d=""/></g><text id="t2-tag" x="98" y="278" class="tlbl">MOBILE</text><text id="t2-kg" x="98" y="288" class="tlbl am"></text>
    </g>
    <g id="reachship"><rect x="184" y="282" width="40" height="10" rx="3" class="reach"/><text x="204" y="279" text-anchor="middle" class="tiny am">REACH</text></g>
    <line id="plume" x1="226" y1="287" x2="262" y2="287" class="plume"/>
    <rect id="wo" x="4" y="92" width="352" height="204" class="wo"/>
  </svg>
            <div class="hud-statusrow"><span id="hud-status" class="status">STANDBY</span><span class="chip" id="chip-seal" hidden>SEAL GREEN</span><span class="chip amber" id="chip-temp" hidden>TEMP AMBER</span><span class="chip red" id="chip-impact" hidden>IMPACT</span></div>
            <p class="voice" id="hud-voice" hidden>On comms · <a href="/crew/" id="hud-voice-name"></a></p>
            <ol class="log" id="hud-log" aria-label="Display log, newest first. Each entry jumps to its paragraph."></ol>
            <div class="evnav"><button type="button" id="ev-prev">◀ Previous cue</button><button type="button" id="ev-next">Next cue ▶</button></div>
            <p class="legend">◆ Kade · ● Dustin · ▭ sled · ◦ Bees · press T for thermal</p>
          </div>
          <p id="hud-live" class="visually-hidden" aria-live="polite"></p>
        </aside>
        </div>

        <article class="chapter" id="chapter">
          {PARAS.map((p, i) => <p data-i={i} data-t={MARKS[i]} set:html={p} />)}
          <p class="end">End of Chapter Four</p>
        </article>
      </div>

      <section class="next" aria-labelledby="next-title">
        <div class="next-cover"><Cover width={150} /></div>
        <div>
          <p class="eyebrow">Continues in Chapter Five: The Medbay</p>
          <h2 id="next-title">The Jovian Crisis</h2>
          <p>
            He gets the survivors out. Then the ship burns, the proof goes with her, and the claim becomes the most
            dangerous thing in the Jovian system.
          </p>
          <p class="rel">Book One of The Capa Incident · <time datetime={RELEASE_ISO}>{RELEASE}</time></p>
          <div class="actions">
            <a class="btn" href={AMAZON_URL} rel="noopener">{AMAZON_LABEL}</a>
            <a class="btn btn--ghost" href="/about/#signup">{SIGNUP_CTA}</a>
          </div>
          <p class="more"><a href="/ship/">Tour <em>Cooper’s Reach</em></a> · <a href="/crew/">Meet the crew</a> · <a href="/book/">About the book</a></p>
        </div>
      </section>
    </div>
  </section>
</Base>

<script is:inline define:vars={{ CUES, MARKS, PARAS_N: PARAS.length }}>
// Green v7: visual suit display for Chapter Four. Driven only by the current paragraph index (narration time, or
// scroll position when the audio is paused). Every state is folded from cues at or before that paragraph, so the
// display can never run ahead of the text. Content: blue's cue list, cut to red's gate and the coordinator's
// leave-out list (no shear vectors, captain, flight recorder, spool, lockout, mutiny, survivor identity).
(() => {
  const N = PARAS_N;
  // Positions on an abstract path (not a deck plan). Nose is left, aft is right.
  const P = { cross: [300, 112], hull: [268, 140], airlock: [262, 150], chamber: [254, 166], vest: [236, 176], pinch: [194, 176],
    quarters: [148, 176], door: [104, 176], deck: [72, 192], run: [120, 204], pdoors: [160, 206], out: [204, 258], reach: [204, 280], aft: [302, 198] };
  const stage = (p, table) => { let v = null; for (const [from, val] of table) if (p >= from) v = val; return v; };
  const KADE = [[0, 'cross'], [4, 'hull'], [6, 'airlock'], [11, 'chamber'], [30, 'vest'], [38, 'pinch'], [42, 'quarters'], [56, 'door'], [68, 'deck'], [83, 'run'], [92, 'pdoors'], [99, 'out'], [104, 'reach']];
  const DUSTIN = [[0, 'cross'], [4, 'hull'], [6, 'airlock'], [11, 'chamber'], [30, 'vest'], [40, 'aft'], [56, 'door'], [59, 'vest'], [64, 'door'], [68, 'deck'], [83, 'run'], [92, 'pdoors'], [99, 'out'], [104, 'reach']];
  const SLED = [[0, 'cross'], [4, 'hull'], [6, 'airlock'], [11, 'chamber'], [30, 'vest'], [64, 'door'], [68, 'deck'], [83, 'run'], [92, 'pdoors'], [98, 'out'], [104, 'reach']];
  const TETHER = (p) => (p >= 1 && p <= 10) || (p >= 30 && p <= 35) || (p >= 83 && p <= 95);
  const OFF = { dustin: [14, 10], sled: [-2, 14] };
  const BEES = (p) => {
    if (p < 31 || p >= 100) return null;
    if (p >= 98) return { front: [[214, 248], [238, 262], [190, 270]], rear: null, swept: true };
    if (p >= 92) return { front: [[178, 200], [190, 212], [170, 216]], rear: p >= 88 ? null : [132, 200] };
    if (p >= 87) return { front: [[146, 200], [158, 212], [138, 214]], rear: [96, 198], rearLost: p >= 88 };
    if (p >= 56) return { all: [[96, 164], [86, 188], [70, 172], [58, 200]] };
    if (p >= 38) return { all: [[176, 166], [160, 188], [136, 166], [122, 188]] };
    return { all: [[222, 166], [206, 188], [184, 166], [166, 188]] };
  };
  // Blue's labels (OK rows only). [paragraph, label, tone]
  const EVENTS = [
    [0, 'PRESSORS ACTIVE · HR HIGH'], [1, 'TETHER TAUT'], [2, 'RADIATOR SHEARED · HULL INTACT'], [3, 'THERMAL: AFT HOT'],
    [4, 'GRIP LOCKED · R BOOT SLOW'], [5, 'HULL VIBRATION'], [6, 'OUTER LOCK JAMMED'], [7, 'SPREADER ANCHORED'], [8, 'COVER BREACHED'],
    [9, 'OUTER HATCH OPEN'], [11, 'OUTER HATCH SEALED · LAMPS'], [14, 'INNER HATCH OVERPRESSURE'], [15, 'BLEED VALVE SEIZED'],
    [17, 'CLEAR OF HATCH LINE'], [20, 'IMPACT · RCS BURST', 'red'], [21, 'SEAL GREEN · NO BREACH'], [22, 'DUSTIN: OK'],
    [24, 'EXT TEMP RISING', 'amber'], [25, 'QUENCH 55 MIN'], [27, 'GEL 40 MIN · BINGO SET'], [29, 'BINGO LOCKED'],
    [31, 'BEES 4 OUT'], [32, 'WIREFRAME LIVE · GEL PUMP STRAIN'], [33, 'VISOR FILM CLEAR'], [34, 'BOTTLENECK AHEAD'],
    [36, 'SLED STAGED'], [38, 'SLICK STRAIN · HOLDING'], [39, 'TEMP AMBER', 'amber'], [41, 'ANOMALY FORWARD'], [42, 'HEAT SHIMMER'],
    [43, 'FATALITIES LOGGED'], [53, '2 LIFE SIGNS · COMMAND DECK', 'red'], [56, 'DOOR MAG-LOCKED'], [60, 'T1 WEAK · T2 MOBILE'],
    [62, 'T2 MASS 61 KG'], [63, 'PATCH STAGED'], [64, 'SLED ON SITE'], [67, 'DOOR OPEN'], [71, 'THRUSTER BURST'], [73, 'T2 SEDATED'],
    [77, 'T1 RED TAG', 'red'], [80, 'POD: 2 ABOARD'], [82, 'POD SEALED'], [84, 'REROUTE: MID-SHIP HATCH', 'amber'], [86, 'SLED IMPACT'],
    [87, 'DUAL PATH: YOU · SLED'], [88, 'REAR BEE LOST'], [89, 'REAR BLIND', 'amber'], [92, 'PRESSURE DOOR SEALED · VACUUM BEYOND', 'red'],
    [94, 'PAST BINGO', 'red'], [96, 'TETHER RELEASED · ANCHOR'], [98, 'BEES 0 · BLOWOUT', 'red'], [100, 'SLED SECURED'], [101, 'RCS DRY', 'amber'],
    [102, 'BALLISTIC', 'red'], [103, 'REACH INBOUND'], [104, 'IN THE NET'], [106, 'AIRLOCK SEALED'], [108, 'REACH BURNING'], [109, 'WHITEOUT'], [111, 'HUD OFF'],
  ];
  const SPEAK = { 2: 'Cassandra', 13: 'Cassandra', 25: 'Cassandra', 29: 'Cassandra', 62: 'Cassandra', 84: 'Cassandra, for Paul', 94: 'Cassandra', 107: 'Cassandra',
    24: 'Carrie', 52: 'Carrie', 105: 'Carrie', 18: 'Dustin', 23: 'Dustin', 26: 'Dustin', 37: 'Dustin', 66: 'Dustin', 82: 'Dustin', 89: 'Dustin', 93: 'Dustin', 103: 'Gunnar' };

  const $ = (id) => document.getElementById(id);
  const svg = $('hudsvg'), paras = [...document.querySelectorAll('#chapter p[data-i]')], aud = $('aud');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const NS = 'http://www.w3.org/2000/svg';
  const el = (tag, attrs, parent) => { const e = document.createElementNS(NS, tag); for (const k in attrs) e.setAttribute(k, attrs[k]); (parent || svg).appendChild(e); return e; };
  const g = (id) => svg.querySelector('#' + id);
  const put = (node, [x, y]) => { node.style.transform = `translate(${x}px, ${y}px)`; };

  // Bees: four pucks, built once.
  const bees = [0, 1, 2, 3].map(() => { const b = el('g', { class: 'bee' }, g('bees')); el('circle', { r: 4 }, b); el('circle', { r: 1.4, class: 'core' }, b); return b; });

  function fold(p) {
    const s = { bingo: null, gel: null, quench: null, ticks: [], label: null, tone: '', labelP: -1, setBy: {} };
    for (let i = 0; i <= p; i++) {
      const c = CUES[i];
      if (c) for (const k of ['bingo', 'gel', 'quench']) if (c[k]) { s[k] = c[k]; s.setBy[k] = i; if (k === 'bingo') s.ticks.push([c[k], i]); }
    }
    for (const [i, l, t] of EVENTS) if (i <= p) { s.label = l; s.tone = t || ''; s.labelP = i; }
    return s;
  }
  const BW = 214;
  function bar(name, v, max) {
    const fill = g(name + '-fill'), txt = g(name + '-val');
    if (!v) { fill.setAttribute('width', 0); txt.textContent = '··'; return; }
    if (v === 'PAST') { fill.setAttribute('width', BW); fill.setAttribute('class', 'fill past'); txt.textContent = 'PAST'; return; }
    fill.setAttribute('width', Math.max(2, (+v / max) * BW)); txt.textContent = v + ' MIN';
    fill.setAttribute('class', 'fill' + (name === 'bingo' && +v <= 11 ? ' warn' : ''));
  }
  let cur = -2;
  function paint(p) {
    if (p === cur) return; cur = p;
    const s = fold(p);
    // clocks: step only when the text speaks a number
    bar('bingo', s.bingo, 25); bar('gel', s.gel, 40); bar('quench', s.quench, 55);
    const tk = g('ticks'); tk.innerHTML = '';
    s.ticks.forEach(([v, i]) => { if (v === 'PAST') return; const x = 72 + (+v / 25) * BW; const t = el('line', { x1: x, x2: x, y1: 16, y2: 30, class: 'tick' }, tk); t.dataset.p = i; });
    ['bingo', 'gel', 'quench'].forEach((k) => g(k + '-row').dataset.p = s.setBy[k] ?? '');
    // status line and chips
    $('hud-status').textContent = s.label || 'STANDBY';
    $('hud-status').className = 'status ' + s.tone;
    $('chip-seal').hidden = p < 21 || p >= 111; $('chip-temp').hidden = p < 39 || p >= 111;
    $('chip-impact').hidden = !(p >= 19 && p <= 20);
    const who = SPEAK[p]; $('hud-voice').hidden = !who; if (who) $('hud-voice-name').textContent = who;
    // thermal: available once the text turns the overlay on
    const thermOK = p >= 3; $('therm').disabled = !thermOK;
    svg.classList.toggle('thermal', thermOK && $('therm').getAttribute('aria-pressed') === 'true');
    // path: nodes appear as the text reaches them
    const show = (id, on) => g(id).classList.toggle('on', on);
    show('n-airlock', p >= 6); show('n-staged', p >= 36); show('n-pinch', p >= 38); show('n-quarters', p >= 41); show('n-door', p >= 56);
    show('n-aft', p >= 40); show('lane-in', p >= 32); show('chevrons', p >= 32 && p < 83);
    show('lane-out', p >= 84); show('n-hatch', p >= 84); show('n-pdoors', p >= 92); show('dual', p >= 87 && p < 96);
    g('n-airlock').classList.toggle('dead', p >= 84);
    // people and the sled
    const q0 = Math.max(p, 0); svg.classList.toggle('pre', p < 0);
    const kp = P[stage(q0, KADE)], dp = P[stage(q0, DUSTIN)], sp = P[stage(q0, SLED)];
    const off = (pt, o) => [pt[0] + o[0], pt[1] + o[1]];
    put(g('kade'), kp); put(g('dustin'), off(dp, OFF.dustin));
    const sledPt = stage(q0, SLED) === 'vest' && p >= 36 && p < 64 ? sp : off(sp, OFF.sled);
    put(g('sled'), sledPt);
    const tether = g('tether'); tether.classList.toggle('on', TETHER(p));
    tether.setAttribute('x1', kp[0]); tether.setAttribute('y1', kp[1]); tether.setAttribute('x2', sledPt[0]); tether.setAttribute('y2', sledPt[1]);
    // Bees
    const b = BEES(p);
    bees.forEach((bee, i) => {
      let pt = null, cls = 'bee';
      if (b && b.all) pt = b.all[i];
      else if (b && i < 3) { pt = b.front[i]; if (b.swept) cls += ' swept'; }
      else if (b && i === 3 && b.rear) { pt = b.rear; if (b.rearLost) cls += ' lost'; }
      bee.setAttribute('class', cls + (pt ? ' on' : ''));
      if (pt) put(bee, pt);
    });
    // the two traces: static shapes, never extended past the text, never flat
    show('traces', p >= 60 && p < 109);
    g('t2-kg').textContent = p >= 62 ? '61 KG' : '';
    g('t2-wave').setAttribute('d', p >= 73 ? 'M4 20 h10 l3 -5 l3 8 l3 -3 h18 l3 -5 l3 8 l3 -3 h20' : 'M4 20 l3 -9 l3 14 l3 -5 l3 -7 l3 12 l3 -6 l3 -8 l3 13 l3 -5 l3 -8 l3 12 l3 -5 h18');
    g('t2-tag').textContent = p >= 73 ? 'SEDATED' : 'MOBILE';
    g('t1-tag').textContent = p >= 77 ? 'RED TAG' : 'WEAK';
    g('t1-tag').setAttribute('class', p >= 77 ? 'tlbl red' : 'tlbl');
    g('pod').textContent = p >= 82 ? 'POD SEALED' : p >= 80 ? 'POD · 2 ABOARD' : 'BEES FEED · 2 TRACES';
    // ending
    show('reachship', p >= 103); show('plume', p >= 108);
    svg.classList.toggle('whiteout', p >= 109 && p < 111); svg.classList.toggle('off', p >= 111);
    g('hull').classList.toggle('gone', p >= 109);
    // log and phone strip
    const past = EVENTS.filter(([i]) => i <= p).slice(-5).reverse();
    $('hud-log').innerHTML = past.map(([i, l, t]) => `<li><button type="button" data-p="${i}" class="${t || ''}"><span class="lp">¶${i + 1}</span>${l}</button></li>`).join('');
    $('strip-bingo').textContent = s.bingo ? (s.bingo === 'PAST' ? 'PAST' : s.bingo) : '··';
    $('strip-gel').textContent = s.gel || '··'; $('strip-quench').textContent = s.quench || '··';
    $('strip-status').textContent = (s.label || 'STANDBY').split(' · ')[0];
    $('strip-bingo').parentElement.className = 'sb ' + (s.bingo === 'PAST' ? 'red' : s.bingo && +s.bingo <= 11 ? 'amber' : '');
    // one polite live region, at paragraph changes only
    const ev = EVENTS.find(([i]) => i === p); if (ev) $('hud-live').textContent = ev[1].toLowerCase();
