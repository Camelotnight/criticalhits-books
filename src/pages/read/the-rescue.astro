.mk,.bee{transform-box:view-box;transition:transform .7s cubic-bezier(.3,.1,.2,1)}
.kade path{fill:#e3a857;stroke:#0a1118}.dustin circle{fill:#7cc8dc;stroke:#0a1118}.sled rect{fill:#0a1118;stroke:#dde3ea}
.bee{opacity:0}.bee.on{opacity:1}.bee circle{fill:rgba(124,200,220,.18);stroke:#7cc8dc}.bee .core{fill:#7cc8dc;stroke:none}
.bee.lost circle{stroke:#5f6f84;fill:none}.bee.lost .core{fill:#5f6f84}.bee.swept{opacity:.35}
.tbox{fill:#0a1118;stroke:#22404d}.tlbl{font-size:7.5px;fill:#9cc7d3;letter-spacing:.1em}.tlbl.red{fill:#f08a72}
.wave{fill:none;stroke-width:1.6}.wave.weak{stroke:#e3a857}.wave.fast{stroke:#7cc8dc}
.reach{fill:#141c27;stroke:#e3a857}.plume{stroke:#ffd48a;stroke-width:3;stroke-linecap:round}
