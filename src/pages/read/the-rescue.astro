.voice{margin:0 0 .35rem;font-size:.66rem;letter-spacing:.12em;text-transform:uppercase;color:#6d7f95}.voice a{color:var(--signal)}
.log{list-style:none;margin:.2rem 0 .4rem;padding:0;display:grid;gap:.2rem}
.log button{width:100%;text-align:left;display:flex;gap:.45rem;align-items:baseline;text-transform:none!important;letter-spacing:.06em!important;font-size:.7rem!important;color:#9cc7d3!important}
.log li:first-child button{color:#dde3ea!important;border-color:#2b5361}
.log button.amber{color:#e3a857!important}.log button.red{color:#f08a72!important}
.log .lp{color:#4f6076;font-variant-numeric:tabular-nums;min-width:2.4em}
.evnav{display:flex;gap:.4rem}.evnav button{flex:1}
.legend{margin:.45rem 0 0;font-size:.64rem;color:#6d7f95;letter-spacing:.06em}
.strip{display:none}
@media (max-width:959px){
  .body-grid{grid-template-columns:minmax(0,1fr)}
