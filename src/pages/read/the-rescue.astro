      last = now; const r = now.getBoundingClientRect();
      if (r.top < 140 || r.bottom > innerHeight - 40) now.scrollIntoView({ block: 'center', behavior: reduce.matches ? 'auto' : 'smooth' });
    });
    aud.addEventListener('loadedmetadata', () => {
      try { const s = +localStorage.getItem('rescue-pos'); if (s > 5 && aud.currentTime < 1) aud.currentTime = s; } catch (e) {}
    }, { once: true });
  })();
</script>

<style>
  .read { max-width: 72rem; }
