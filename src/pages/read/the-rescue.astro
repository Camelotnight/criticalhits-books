  svg.addEventListener('click', (e) => { const t = e.target.closest('[data-p]'); if (t && t.dataset.p !== '') jump(+t.dataset.p); });
  const stepTo = (dir) => { const list = EVENTS.map(([i]) => i); const next = dir > 0 ? list.find((i) => i > cur) : [...list].reverse().find((i) => i < cur); if (next !== undefined) jump(next); };
  $('ev-prev').onclick = () => stepTo(-1); $('ev-next').onclick = () => stepTo(1);
