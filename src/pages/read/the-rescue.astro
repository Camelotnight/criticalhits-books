  // Drive: the narration when it is playing; otherwise the scroll position.
  let lockUntil = 0;
  function fromScroll() {
    if (!aud.paused || Date.now() < lockUntil) return;
    const line = innerHeight * 0.42; let p = -1;
    for (let i = 0; i < paras.length; i++) { if (paras[i].getBoundingClientRect().top <= line) p = i; else break; }
    paint(p);
  }
  let ticking = false;
  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(() => { ticking = false; fromScroll(); }); } }, { passive: true });
  aud.addEventListener('timeupdate', () => { let p = -1; for (let i = 0; i < N; i++) { if (MARKS[i] <= aud.currentTime + 0.05) p = i; else break; } paint(p); });
  function jump(p) {
    lockUntil = Date.now() + 900; paint(p);
    paras[p].scrollIntoView({ block: 'center', behavior: reduce.matches ? 'auto' : 'smooth' });
