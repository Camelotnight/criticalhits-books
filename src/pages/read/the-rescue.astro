.hud-head{display:flex;align-items:center;gap:.4rem;margin-bottom:.45rem}
.hud-title{margin:0 auto 0 0;font-size:.7rem;letter-spacing:.16em;text-transform:uppercase}
.hud2 button{font-family:var(--font-display);font-size:.66rem;letter-spacing:.12em;text-transform:uppercase;background:var(--bg);color:var(--muted);border:1px solid var(--line-strong);border-radius:3px;padding:.3rem .5rem;cursor:pointer;min-height:32px}
.hud2 button[aria-pressed="true"]{border-color:#c2571f;color:#f0b07a}
.hud2 button:disabled{opacity:.4;cursor:default}
#hudsvg{width:100%;height:auto;display:block}
#hudsvg text{font-family:var(--font-display)}
.visor{fill:rgba(124,200,220,.03);stroke:rgba(124,200,220,.45);stroke-width:1.2}
.glare{fill:none;stroke:rgba(255,255,255,.06);stroke-width:6}
.rl{fill:#6d9fae;font-size:9px;letter-spacing:.14em}.rv{fill:#dde3ea;font-size:10px;text-anchor:end;font-variant-numeric:tabular-nums}
.track{fill:#132029;stroke:#22404d}.fill{fill:#7cc8dc}.fill.cool{fill:#5fb0c8}.fill.hot{fill:#c9824a}.fill.warn{fill:#e3a857}.fill.past{fill:#d0442b}
.row{cursor:pointer}.tick{stroke:#dde3ea;stroke-opacity:.5;stroke-width:1;cursor:pointer}
.sep{stroke:#22404d}.tiny{font-size:7.5px;letter-spacing:.12em;fill:#6d9fae}.tiny.dim{fill:#3f6270}.cy{fill:#7cc8dc}.am{fill:#e3a857}
.hullp{fill:rgba(124,200,220,.04);stroke:#7cc8dc;stroke-opacity:.6;transition:fill .4s}
.ribs{stroke:#7cc8dc;stroke-opacity:.18;stroke-dasharray:2 3}
#hudsvg.thermal .hullp{fill:url(#heat);stroke-opacity:.35}#hudsvg.thermal .ribs{stroke-opacity:.1}
#hull.gone{opacity:.12}
.lane{fill:none;stroke:#7cc8dc;stroke-opacity:.55;stroke-dasharray:3 3}.lane.out{stroke:#e3a857}
.chev path{fill:none;stroke:#7cc8dc;stroke-width:1.4}
.d-you{fill:none;stroke:#7cc8dc;stroke-width:1.2}.d-sled{fill:none;stroke:#e3a857;stroke-width:2.4;stroke-opacity:.7}
.node circle,.node rect{fill:#0a1118;stroke:#7cc8dc;stroke-width:1.2}.node text{font-size:7px;letter-spacing:.1em;fill:#9cc7d3}
.node.hollow circle{stroke-dasharray:2 2;stroke-opacity:.6}
.node.red rect{stroke:#d0442b;fill:rgba(208,68,43,.25)}.node.red text{fill:#f08a72}
.node.amber circle{stroke:#e3a857}.node.amber text{fill:#e3a857}
.node .x{display:none;stroke:#d0442b}.node.dead .x{display:inline}.node.dead circle{stroke-opacity:.3}
